    p += 10. * pre(-1, -9, gl_FragCoord);
    p += 450. * pre(-1, -7, gl_FragCoord);
    p += 5400. * pre(-1, -5, gl_FragCoord);
    p += 25200. * pre(-1, -3, gl_FragCoord);
