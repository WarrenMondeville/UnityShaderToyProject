    p += 1200. * pre(-6, 2, gl_FragCoord);
    p += 210. * pre(-6, 4, gl_FragCoord);
    p += 252. * pre(-5, -5, gl_FragCoord);
    p += 2100. * pre(-5, -3, gl_FragCoord);
